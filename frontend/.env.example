# ── SEO : domaine de production du site ──
# Utilisé au build pour remplacer __SITE_URL__ dans :
#   - index.html (canonical, og:url, og:image, JSON-LD)
#   - public/sitemap.xml et public/robots.txt
# Saisissez la MÊME valeur dans Vercel → Settings → Environment Variables.
# Exemple : VITE_SITE_URL=https://mon-association.vercel.app
VITE_SITE_URL=
